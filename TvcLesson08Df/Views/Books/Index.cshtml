@model IEnumerable<TvcLesson08Df.Models.Book>

@{
    ViewData["Title"] = "Quản lý Sách (Books)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 text-primary mb-1"><i class="bi bi-book-fill me-2"></i>Quản lý Sách (Books)</h1>
        <p class="text-muted mb-0">Thực hành thao tác CRUD với Entity Framework Core</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Thêm sách mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Tìm theo tên sách, tác giả..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Tất cả thể loại --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="publisherId" class="form-select" asp-items="ViewBag.Publishers">
                    <option value="">-- Tất cả nhà xuất bản --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill"><i class="bi bi-search"></i> Tìm</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách sách -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ảnh</th>
                        <th>Tên sách</th>
                        <th>Tác giả</th>
                        <th>Thể loại</th>
                        <th>Nhà xuất bản</th>
                        <th>Đơn giá</th>
                        <th>Tồn kho</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4" style="width: 70px;">
                                <div class="bg-light rounded d-flex align-items-center justify-content-center text-secondary border" style="width: 50px; height: 65px; font-size: 20px;">
                                    <i class="bi bi-book"></i>
                                </div>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.BookId" class="fw-bold text-decoration-none text-dark">
                                    @item.Title
                                </a>
                                <div class="text-muted small">Mã: #@item.BookId</div>
                            </td>
                            <td>@(item.Author ?? "Chưa rõ")</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    @(item.Category?.CategoryName ?? "Chưa phân loại")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(item.Publisher?.PublisherName ?? "Chưa rõ NXB")
                                </span>
                            </td>
                            <td class="text-danger fw-bold">
                                @item.Price.ToString("N0") đ
                            </td>
                            <td>
                                @if (item.Quantity > 10)
                                {
                                    <span class="badge bg-success">@item.Quantity</span>
                                }
                                else if (item.Quantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">Còn @item.Quantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-info me-1">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy sách nào.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
