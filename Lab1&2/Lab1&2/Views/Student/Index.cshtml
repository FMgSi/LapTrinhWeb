@model IEnumerable<MyWebApp.Models.Student>

<div class="container-fluid px-4 mt-3">
    <a asp-action="Create" class="btn btn-primary mb-3">Create Student</a>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>@s.DateOfBorth.ToShortDateString()</td>
                    <td>
                        @{
                            string str = "";
                            switch (s.Branch)
                            {
                                case MyWebApp.Models.Branch.IT:
                                    str = "CNTT";
                                    break;
                                case MyWebApp.Models.Branch.BE:
                                    str = "Kinh tế";
                                    break;
                                case MyWebApp.Models.Branch.CE:
                                    str = "Công trình";
                                    break;
                                case MyWebApp.Models.Branch.EE:
                                    str = "Điện - Điện tử";
                                    break;
                            }
                        }
                        @str
                    </td>
                    <td>@(s.Gender == MyWebApp.Models.Gender.Male ? "Nam" : "Nữ")</td>
                    <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@s.Address</td>
                    <td>@s.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Đoạn Script dùng cho RenderSection ở Lab 2 *@
@section Scripts {
    <script>
        var table = document.querySelector('table');
        if (table) {
            table.onclick = function onTableClick() {
                table.style.backgroundColor = 'yellow';
            }
        }
    </script>
}
