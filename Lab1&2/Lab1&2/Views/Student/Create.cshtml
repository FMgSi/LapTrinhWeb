@model MyWebApp.Models.Student

<div class="container mt-3">
    <h3>Thêm mới sinh viên</h3>
    
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-controller="Student" asp-action="Create" method="post" class="mt-3">
        <!-- Họ tên -->
        <div class="form-group row mb-2">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <!-- Email -->
        <div class="form-group row mb-2">
            <label asp-for="Email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <!-- Password -->
        <div class="form-group row mb-2">
            <label asp-for="Password" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <input asp-for="Password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <!-- Branch -->
        <div class="form-group row mb-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<MyWebApp.Models.Branch>()">
                    <option value="">-- Chọn ngành --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <!-- IsRegular -->
        <div class="form-group row mb-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Chính quy</label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox" class="form-check-input mt-0" asp-for="IsRegular" />
            </div>
        </div>

        <!-- DateOfBorth -->
        <div class="form-group row mb-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <!-- Gender -->
        <div class="form-group row mb-2">
            <label class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @if (ViewBag.AllGenders != null)
                {
                    @foreach (var gender in ViewBag.AllGenders)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="gender_@gender" />
                            <label class="form-check-label" for="gender_@gender">@gender</label>
                        </div>
                    }
                }
                <span asp-validation-for="Gender" class="text-danger d-block"></span>
            </div>
        </div>

        <!-- Address -->
        <div class="form-group row mb-2">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            </div>
        </div>

        <!-- Score -->
        <div class="form-group row mb-2">
            <label asp-for="Score" class="col-sm-2 col-form-label">Điểm</label>
            <div class="col-sm-10">
                <input asp-for="Score" type="number" step="0.1" class="form-control" placeholder="0.0 - 10.0" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>
