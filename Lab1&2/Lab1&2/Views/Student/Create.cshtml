@model MyWebApp.Models.Student

<div class="container mt-3">
    <h3>Thêm mới sinh viên</h3>
    <form asp-controller="Student" asp-action="Create" method="post">
        <div class="form-group row mb-3">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" required>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" type="email" class="form-control" placeholder="Email" required>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Password" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" required>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<MyWebApp.Models.Branch>()"></select>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ chính quy</label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox" class="form-check-input mt-0" asp-for="IsRegular">
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control" required>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @if (ViewBag.AllGenders != null)
                {
                    @foreach (var gender in ViewBag.AllGenders)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="gender_@gender">
                            <label class="form-check-label" for="gender_@gender">@gender</label>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            </div>
        </div>

        <div class="form-group row mb-3">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>
