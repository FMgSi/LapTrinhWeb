<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(ViewData["Title"] ?? "Management System")</title>
    <link href="/css/style.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="sb-nav-fixed">
    <!-- Top Nav -->
    <partial name="TopNav" />

    <div id="layoutSidenav" class="d-flex">
        <!-- Left Side Menu qua ViewComponent -->
        <div id="layoutSidenav_nav" style="width: 250px; min-height: 100vh;" class="bg-light border-end">
            @await Component.InvokeAsync("Render")
        </div>

        <!-- Main Content -->
        <div id="layoutSidenav_content" class="flex-grow-1">
            <main>
                @RenderBody()
            </main>
            <partial name="Footer" />
        </div>
    </div>

    <!-- Nạp jQuery trước các kịch bản AJAX -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/scripts.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
