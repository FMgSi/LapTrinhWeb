@model MyWebApp.Models.Learner
@{
    ViewData["Title"] = "Edit Learner";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid px-4 mt-3">
    <h3>Edit Learner</h3>
    <hr />
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="LearnerID" />

        <div class="form-group row mb-3">
            <label asp-for="FirstMidName" class="col-sm-2 col-form-label">First Mid Name</label>
            <div class="col-sm-6">
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="LastName" class="col-sm-2 col-form-label">Last Name</label>
            <div class="col-sm-6">
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="MajorID" class="col-sm-2 col-form-label">Major</label>
            <div class="col-sm-6">
                <select asp-for="MajorID" class="form-select" asp-items="ViewBag.MajorID"></select>
                <span asp-validation-for="MajorID" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="EnrollmentDate" class="col-sm-2 col-form-label">Enrollment Date</label>
            <div class="col-sm-6">
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-6 offset-sm-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </div>
    </form>
</div>
