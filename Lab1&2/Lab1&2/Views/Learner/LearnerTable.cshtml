@model IEnumerable<MyWebApp.Models.Learner>

@{
    int pageNum = ViewBag.pageNum ?? 1;
    int pageIndex = ViewBag.pageIndex ?? 1;
    int totalRecords = ViewBag.totalRecords ?? 0;
    string? mid = ViewBag.mid != null ? ViewBag.mid.ToString() : "";
    string? keyword = ViewBag.keyword != null ? ViewBag.keyword.ToString() : "";
}

<!-- Thông tin tổng quan kết quả -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <div class="text-muted small">
        <i class="fas fa-info-circle text-primary"></i> 
        Hiển thị trang <strong>@pageIndex</strong> / <strong>@pageNum</strong> 
        (Tổng số: <span class="badge bg-primary">@totalRecords</span> sinh viên)
        @if (!string.IsNullOrEmpty(keyword))
        {
            <span class="ms-2">| Từ khóa: <mark class="px-2 py-0">@keyword</mark></span>
        }
    </div>
</div>

@if (!Model.Any())
{
    <!-- Trạng thái không có dữ liệu (Empty State) -->
    <div class="alert alert-warning text-center py-4 my-3 shadow-sm rounded">
        <i class="fas fa-search-minus fa-2x text-warning mb-2 d-block"></i>
        <h5 class="alert-heading">Không tìm thấy sinh viên nào!</h5>
        <p class="mb-2">Không có kết quả nào phù hợp với điều kiện tìm kiếm hoặc chuyên ngành đã chọn.</p>
        <button type="button" class="btn btn-sm btn-outline-warning" id="btnResetFilters">
            <i class="fas fa-sync-alt me-1"></i> Xóa bộ lọc và xem lại tất cả
        </button>
    </div>
}
else
{
    <!-- Bảng danh sách sinh viên -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 70px;" class="text-center">Mã</th>
                    <th>Tên</th>
                    <th>Họ đệm</th>
                    <th>Chuyên ngành</th>
                    <th style="width: 140px;" class="text-center">Ngày nhập học</th>
                    <th style="width: 180px;" class="text-center">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">@s.LearnerID</td>
                        <td class="fw-semibold text-primary">@s.FirstMidName</td>
                        <td>@s.LastName</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                <i class="fas fa-graduation-cap me-1"></i>
                                @(s.Major != null ? s.Major.MajorName : "Chưa phân ngành")
                            </span>
                        </td>
                        <td class="text-center">@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@s.LearnerID" class="btn btn-sm btn-outline-primary me-1" title="Sửa">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@s.LearnerID" class="btn btn-sm btn-outline-danger" title="Xóa">
                                <i class="fas fa-trash-alt"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Thanh phân trang (Pagination) cải tiến -->
    @if (pageNum > 1)
    {
        <nav aria-label="Learner pagination" class="mt-3 d-flex justify-content-center">
            <ul class="pagination pagination-md shadow-sm">
                <!-- Nút Về trang trước (Previous) -->
                <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link page-link-custom" 
                       href="javascript:void(0);" 
                       data-page="@(pageIndex - 1)"
                       data-mid="@mid"
                       data-keyword="@keyword"
                       aria-label="Previous">
                        <span aria-hidden="true">&laquo; Trước</span>
                    </a>
                </li>

                <!-- Danh sách các số trang -->
                @for (int i = 1; i <= pageNum; i++)
                {
                    <li class="page-item @(i == pageIndex ? "active" : "")"
                        data-page="@i"
                        data-mid="@mid"
                        data-keyword="@keyword">
                        <a class="page-link page-link-custom" 
                           href="javascript:void(0);" 
                           data-page="@i"
                           data-mid="@mid"
                           data-keyword="@keyword">
                            @i
                        </a>
                    </li>
                }

                <!-- Nút Sang trang sau (Next) -->
                <li class="page-item @(pageIndex >= pageNum ? "disabled" : "")">
                    <a class="page-link page-link-custom" 
                       href="javascript:void(0);" 
                       data-page="@(pageIndex + 1)"
                       data-mid="@mid"
                       data-keyword="@keyword"
                       aria-label="Next">
                        <span aria-hidden="true">Sau &raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}

