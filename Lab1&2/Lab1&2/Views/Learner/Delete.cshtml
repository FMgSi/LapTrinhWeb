@model MyWebApp.Models.Learner

@{
    ViewData["Title"] = "Xóa Sinh Viên";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-trash-alt me-2"></i> Xác Nhận Xóa Sinh Viên</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-3">
                        <i class="fas fa-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa sinh viên này không? Thao tác này không thể hoàn tác.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Mã sinh viên:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.LearnerID</dd>

                        <dt class="col-sm-4 text-muted">Họ tên đầy đủ:</dt>
                        <dd class="col-sm-8">@Model.LastName @Model.FirstMidName</dd>

                        <dt class="col-sm-4 text-muted">Chuyên ngành:</dt>
                        <dd class="col-sm-8">@(Model.Major?.MajorName ?? "Không rõ")</dd>

                        <dt class="col-sm-4 text-muted">Ngày nhập học:</dt>
                        <dd class="col-sm-8">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="LearnerID" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-1"></i> Xác Nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
