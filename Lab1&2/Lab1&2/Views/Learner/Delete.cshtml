@model MyWebApp.Models.Learner
@{
    ViewData["Title"] = "Delete Learner";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid px-4 mt-3">
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Họ & Tên đệm</dt>
            <dd class="col-sm-10">@Model.FirstMidName</dd>

            <dt class="col-sm-2">Tên</dt>
            <dd class="col-sm-10">@Model.LastName</dd>

            <dt class="col-sm-2">Ngành</dt>
            <dd class="col-sm-10">@Model.Major?.MajorName</dd>

            <dt class="col-sm-2">Ngày nhập học</dt>
            <dd class="col-sm-10">@Model.EnrollmentDate.ToShortDateString()</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="LearnerID" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </form>
    </div>
</div>
