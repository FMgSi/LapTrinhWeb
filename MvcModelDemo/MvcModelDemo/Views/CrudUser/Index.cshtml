@model IEnumerable<MvcModelDemo.Models.User>

@{
    ViewData["Title"] = "Quản lý Người dùng (CRUD)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Danh sách người dùng (CRUD Demo)</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm người dùng mới
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Họ và Tên</th>
                    <th scope="col">Địa chỉ</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-center" style="width: 220px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.name</td>
                            <td>@item.address</td>
                            <td>@item.email</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            Chưa có người dùng nào trong danh sách.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
