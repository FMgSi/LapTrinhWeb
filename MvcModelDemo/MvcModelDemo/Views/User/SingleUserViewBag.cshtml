@{
    ViewData["Title"] = "User Details (ViewBag Demo)";
    var user = ViewBag.user as MvcModelDemo.Models.User;
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Thông tin người dùng (Truyền qua ViewBag)</h4>
            </div>
            <div class="card-body">
                @if (user != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">ID:</dt>
                        <dd class="col-sm-9 fw-bold">@user.Id</dd>

                        <dt class="col-sm-3 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-9">@user.name</dd>

                        <dt class="col-sm-3 text-muted">Địa chỉ:</dt>
                        <dd class="col-sm-9">@user.address</dd>

                        <dt class="col-sm-3 text-muted">Email:</dt>
                        <dd class="col-sm-9">@user.email</dd>
                    </dl>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Không tìm thấy dữ liệu người dùng trong ViewBag!
                    </div>
                }
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
                    &larr; Xem danh sách User (Strongly-typed)
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
