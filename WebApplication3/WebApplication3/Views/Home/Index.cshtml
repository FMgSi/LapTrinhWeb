@{
    Layout = "my_layout";
    ViewData["Title"] = "Trang chủ";
}

<partial name="Banner" />

<hr />

<div class="text-center my-3">
    <button id="loadAjax" class="btn btn-primary px-4 shadow-sm">
        Click load book từ partialResult
    </button>
</div>

<hr />

<div id="data-from-ajax" class="my-4">
    <p class="text-center text-muted fst-italic">Nhấn nút bên trên để tải danh sách sách...</p>
</div>

<hr />
<h3 class="text-primary my-3">Popular Book Load từ BookComponent</h3>

@await Component.InvokeAsync("Book")

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#loadAjax').click(function () {
                $('#data-from-ajax').html('<div class="text-center text-secondary py-3">Đang tải dữ liệu...</div>');

                $('#data-from-ajax').load("/Book/PopularBook", function (response, status, xhr) {
                    if (status === "error") {
                        $('#data-from-ajax').html('<div class="alert alert-danger text-center">Không thể tải dữ liệu: ' + xhr.status + '</div>');
                    }
                });
            });
        });
    </script>
}