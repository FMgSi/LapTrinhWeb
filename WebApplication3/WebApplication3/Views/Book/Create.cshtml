@model WebApplication3.Models.Book
@{
    ViewData["Title"] = "Thêm mới sách";
}

<h2>Thêm mới sách</h2>

<form asp-controller="Book" asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="form-group mb-3">
        <label asp-for="Title">Tên sách</label>
        <input type="text" class="form-control" asp-for="Title" placeholder="Tên sách" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="AuthorId">Tác giả</label>
        <select asp-for="AuthorId" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn tác giả</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="GenerId">Thể loại</label>
        <select asp-for="GenerId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Chọn thể loại</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">Giá sách</label>
        <input type="number" class="form-control" asp-for="Price" placeholder="Giá sách" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="TotalPage">Tổng số trang</label>
        <input type="number" class="form-control" asp-for="TotalPage" placeholder="Tổng số trang" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Image">Hình ảnh/ Poster</label>
        <input type="file" class="form-control" name="ImageUpload" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Sumary">Giới thiệu ngắn</label>
        <textarea class="form-control" asp-for="Sumary" rows="3" placeholder="Nội dung giới thiệu sách..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu lại</button>
</form>