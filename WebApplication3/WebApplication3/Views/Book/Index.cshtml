@model IEnumerable<WebApplication3.Models.Book>
@{
	ViewData["Title"] = "Index";
}

<h2>Danh sach cac cuon sach</h2>

<form action="" method="post" class="form-inline" role="form">
	<div class="form-group">
		<select name="AuthorId" class="form-control" asp-items="@ViewBag.authors">
			<option value="">Chon tac gia</option>
		</select>

		<select name="GenerId" class="form-control" asp-items="@ViewBag.geners">
			<option value="">Chon the loai</option>
		</select>
	</div>
	<button type="submit" class="btn btn-primary">Tim kiem</button>
	<a asp-action="Create" class="btn btn-danger">Them moi</a>
</form>

<hr />
<table class="table table-bordered">
	<thead>
		<tr>
			<th>Id</th>
			<th>Tieu de</th>
			<th>The loai</th>
			<th>GIa</th>
			<th>Hinh anh</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var book in Model)
		{
			<tr>
				<td>@book.Id</td>
				<td>@book.Title</td>
				<td>@book.GenerId</td>
				<td>@book.Price</td>
				<td>
					<img src="@book.Image" alt="@book.Title" width="40"/>
				</td>
				<td>
					<a asp-action="Edit" class="btn btn-sm btn-primary">Sua</a>
				</td>
			</tr>
		}
	</tbody>
</table>

