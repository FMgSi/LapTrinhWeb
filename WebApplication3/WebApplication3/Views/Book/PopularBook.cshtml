@model IEnumerable<WebApplication3.Models.Book>

    <div class="row g-3">
        @foreach (var item in Model)
    {
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 text-center shadow-sm p-2">
                <img src="@item.Image" class="card-img-top mx-auto" style="height: 160px; object-fit: contain;" alt="@item.Title" />
                <div class="card-body p-2 d-flex flex-column justify-content-between">
                    <h6 class="card-title fw-bold my-2">@item.Title</h6>
                    <p class="card-text text-danger fw-bold mb-1">@item.Price.ToString("N0") đ</p>
                </div>
            </div>
        </div>
    }
    </div>
